# Store Inventory System — Environment Configuration
# Copy this file to .env and fill in your secure values

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=store_inventory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_POOL_SIZE=10

APP_HOST=0.0.0.0
APP_PORT=8080
APP_RELOAD=false

STORE_NAME=Hussain's General Store
LOW_STOCK_THRESHOLD=10
CURRENCY_SYMBOL=Rs.

LOG_LEVEL=INFO
ENABLE_AUDIT=true
